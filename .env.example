# VoxWave / 舆澜 runtime configuration
#
# Copy this file to .env before running the backend.
# Never commit your real .env file or API keys.

# OpenAI-compatible LLM endpoint.
# DeepSeek example:
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash

# Zep Cloud memory graph.
# Get a key from https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# Optional accelerated / fallback LLM endpoint.
# Leave these unset if you do not use a second endpoint.
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
